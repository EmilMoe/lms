# Kopiér ikke denne fil manuelt: kør ./gen-secrets.sh, som laver .env med
# tilfældige værdier. Variablerne er beskrevet her.

# Image bygget af .github/workflows/build-canvas.yml (pin gerne et tag med sha)
CANVAS_IMAGE=ghcr.io/OWNER/canvas-lms:latest

# Volumet (se server/setup-server.sh)
DATA_DIR=/mnt/VOLUMENAVN

# Domænet brugerne åbner (uden https://). CANVAS_SSL=true bag Caddy.
CANVAS_DOMAIN=canvas.example.com
CANVAS_SSL=true
CANVAS_PORT=8000
# LTI 1.3 issuer. Standard er Canvas Clouds; sæt evt. https://$CANVAS_DOMAIN
CANVAS_LTI_ISS=https://canvas.instructure.com
PASSENGER_MAX_POOL_SIZE=1

# Hemmeligheder (genereres)
POSTGRES_PASSWORD=
ENCRYPTION_KEY=
CANVAS_JWT_KEY=
CANVAS_LTI_JWK=

# Første admin (bruges kun af "setup")
CANVAS_ADMIN_EMAIL=admin@example.com
CANVAS_ADMIN_PASSWORD=
CANVAS_ACCOUNT_NAME=Canvas test
